 "text": {
  "st": {
   "2:1": "ЗАВАНТАЖЕННЯ...",
   "2:2": "Рівень ",
   "2:3": "Увімкнути звук?",
   "2:4": "ТАК",
   "2:5": "НІ",
   "2:6": "ЗАЧЕКАЙТЕ...",
   "3:1": "ПРОДОВЖИТИ",
   "3:2": "ЗВУК УВІМК.",
   "3:3": "ДІАЛОГ ТАК",
   "3:4": "ЕФЕКТИ-",
   "3:5": "ПЕРЕЗАПУСК",
   "3:6": "МЕНЮ",
   "3:7": "ВИХІД",
   "3:8": "ДІАЛОГ НІ",
   "3:9": "ЗВУК ВИМК.",
   "4:1": "ВИ ПРОГРАЛИ!",
   "4:2": "РІВЕНЬ ПРОЙДЕНО!",
   "4:3": "ВІТАЄМО!",
   "9:1": "УВІМК.",
   "9:2": "ВИМК.",
   "10:1": "ВИ ВПЕВНЕНІ?",
   "11:1": "НОВА ГРА",
   "11:2": "ПРОДОВЖИТИ",
   "11:3": "ВИБІР РІВНЯ",
   "11:4": "НАЛАШТУВАННЯ",
   "11:5": "ДОПОМОГА",
   "11:6": "ПРО ГРУ",
   "11:7": "ВИХІД",
   "12:1": "ВИБІР",
   "12:2": "НАЗАД",
   "12:4": "МЕНЮ",
   "12:5": "ДАЛІ",
   "12:6": "ВИХІД",
   "13:1": "ЗВУК ",
   "13:2": "ВІБРО ",
   "13:3": "НАЗАД",
   "14:1": "ЗІ ЗВУКОМ",
   "14:2": "БЕЗ ЗВУКУ",
   "15:1": "Рівень "
  },
  "tlk": {
   "1:1": "Як тут усе розтрощено!",
   "2:1": "Чую, щось рухається.",
   "3:1": "Дозиметр зашкалює, час забиратися!",
   "4:1": "Мертва зона...",
   "5:1": "Є рух...",
   "6:1": "Якого біса я тут стирчу?",
   "7:1": "Жахливий сморід!",
   "8:1": "Здається, тут щось здохло?",
   "9:1": "Що тут коїться?",
   "10:1": "Скільки потвор?!",
   "11:1": "Тут відбувається щось жахливе!",
   "12:1": "Це кляте опромінення...",
   "13:1": "О-о-о... ні, мій дозиметр зламався!",
   "14:1": "Покидьки!",
   "15:1": "Який жах!",
   "16:1": "Слава Богу, пройшов!",
   "17:1": "Нарешті все позаду!",
   "18:1": "Доповідаю: наказ виконано.",
   "19:1": "Зачистку завершено.",
   "20:1": "Здається, частину цієї гидоти я знищив!",
   "21:1": "Так, радіація спричиняє масштабні мутації!",
   "22:1": "Усе це — наслідок опромінення!",
   "23:1": "Здається, цьому жахіттю немає кінця!",
   "24:1": "Не дивно, що почалися мутації!",
   "25:1": "Уперед, мерзотники!",
   "26:1": "Ідіоти! Я ще живий!",
   "27:1": "Викликаю базу: завдання виконано.",
   "28:1": "Це не люди!!!",
   "29:1": "Мутанти... Здохни, потворо!",
   "30:1": "Вони всюди...",
   "31:1": "Здохни, потворо!",
   "32:1": "Клята мерзота!",
   "33:1": "Таке й уві сні не насниться!",
   "34:1": "Жахливе видовище!",
   "35:1": "Сволото! Я тут усе рознесу!",
   "36:1": "Потворні виродки!",
   "37:1": "Здохни, поганко!",
   "38:1": "Так точно, завдання зрозумів.",
   "39:1": "Постараюся всіх знешкодити.",
   "40:1": "Тут повно монстрів.",
   "41:1": "Дозвольте продовжити?",
   "42:1": "На зв'язку.",
   "43:1": "Доповідайте про обстановку!",
   "44:1": "Поки що все тихо!",
   "45:1": "Бачу рухомий об'єкт!",
   "46:1": "Здається, вони рухаються до мене!",
   "47:1": "Втрачено візуальний контакт з об'єктом!",
   "48:1": "Дай Боже, щоб вистачило набоїв!",
   "49:1": "_Допоможи, брате, сам не виживу...",
   "50:1": "_Мене щось покусало...",
   "51:1": "_Нарешті підмога!",
   "52:1": "_Рятуйте!",
   "53:1": "_Перев'яжи, зупини кров!",
   "54:1": "_Візьми джгут. Перетягни ногу.",
   "55:1": "_А-а-а... я серйозно поранений...",
   "56:1": "_Допоможи мені, солдате!",
   "57:1": "_У всьому винна радіація...",
   "58:1": "_Як же мені боляче...",
   "59:1": "_Як боляче!",
   "60:1": "_Допоможи мені...",
   "61:1": "_Допоможи мені...",
   "62:1": "_Допоможи! Хай цей біль мине!",
   "63:1": "_Допоможи мені!",
   "64:1": "_Я задихаюся, допоможи мені...",
   "65:1": "Тримайся, брате!",
   "66:1": "Зараз тобі допоможу!",
   "67:1": "Тобі терміново потрібна допомога!",
   "68:1": "Базо, я знайшов ще одного!",
   "69:1": "Солдате! Ти зможеш іти?",
   "70:1": "Як довго ти вже тут?",
   "71:1": "Зачекай трохи.",
   "72:1": "Обережно, я йду!",
   "73:1": "Дивись, не підстрель мене!",
   "74:1": "От зараза! Може, тебе прибрати, брате?",
   "75:1": "Як довго ти вже тут?",
   "76:1": "_А-а-а! За що?!",
   "77:1": "_Ти мене підстрелив...",
   "78:1": "_Я хочу жити! Не стріляй!",
   "79:1": "_Свої, свої! У кого ти стріляєш?",
   "80:1": "_Якого біса ти стріляєш у своїх?",
   "81:1": "_Опусти автомат!",
   "82:1": "_Я вже весь поранений!",
   "83:1": "_Брате, я свій, не стріляй!",
   "84:1": "_Припини стріляти! Свої!"
  },
